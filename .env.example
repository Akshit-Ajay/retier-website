# Copy to .env (or export) only if you need to override defaults. Never commit .env.

# Backend
APP_DATA_DIR=./data                     # where retier.db and uploads/ are created
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# APP_FRONTEND_DIST=                    # override the built-frontend path (default: frontend/dist)

# Frontend (Vite, read at build/dev time)
VITE_API_BASE=                          # empty = same origin / Vite dev proxy
VITE_PROXY_TARGET=http://127.0.0.1:8000 # dev proxy target for /api

# Added in later milestones (placeholders, keep secrets out of git):
# DATABASE_URL=                         # M1: cloud Postgres
# SUPABASE_URL=                         # M1/M2
# SUPABASE_JWT_SECRET=                  # M2: server only
# SUPABASE_SERVICE_ROLE_KEY=            # server only, NEVER in frontend code
# VISION_API_KEY=                       # M3: image-recognition provider
